{
  "name": "agentsforintroverts",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "brand:build": "node scripts/build-brand-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/write-site-version.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test:agents": "node --test agents/agents.test.mjs",
    "test:protocol": "npm --prefix packages/protocol test",
    "test:context": "npm --prefix services/context-kernel test",
    "test:hub": "npm --prefix services/hub test",
    "test:mcp": "npm --prefix services/mcp test",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:mac": "swift test --package-path apps/quiet-desk",
    "verify:site": "node scripts/verify-site.mjs",
    "verify:site:public": "node scripts/verify-site.mjs --base-url https://agentsforintroverts.com",
    "verify": "node scripts/verify.mjs",
    "deploy": "node scripts/deploy-site.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4"
  }
}
